# ---------- Supabase (Auth + données) ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service role : UNIQUEMENT côté serveur (webhook). Aucune exposition côté client.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Kkiapay (paiement) ----------
# Clé PUBLIQUE de paiement (remplacer par la clé LIVE en production)
NEXT_PUBLIC_KKIAPAY_PUBLIC_KEY=
# true = sandbox/test (défaut), false = paiements réels
NEXT_PUBLIC_KKIAPAY_SANDBOX=true
# Secret du webhook Kkiapay (à configurer dans Kkiapay > Développeurs > Webhook)
KKIAPAY_WEBHOOK_SECRET=

# ---------- Envoi d'emails (Brevo) ----------
BREVO_API_KEY=
SENDER_EMAIL=
SITE_URL=